# Reesk - environment config (template)
# Copy to .env and fill in your own values.

# Ollama server (default http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Chat model
MODEL=orcarouter/Qwen3.8-27B-Uncensored:q3_K_S

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://spotify.com

# Gmail (also used by Google Calendar - same OAuth client)
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_ACCOUNT=you@example.com

# Disable ANSI colors (set to 1 to turn off)
NO_COLOR=
