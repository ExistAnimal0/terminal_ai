{
  "name": "gmail",
  "description": "Gmail operations: list, read, send, download attachments. User's email: existanimal0@gmail.com. This tool uses your email: reeskassistant@gmail.com",
  "parameters": {
    "type": "object",
    "required": ["action"],
    "properties": {
      "action": {
        "type": "string",
        "description": "'list', 'read', 'send', or 'download'"
      },
      "query": {
        "type": "string",
        "description": "Gmail search query (for list). e.g. 'is:unread', 'from:boss@x.com'"
      },
      "message_id": {
        "type": "string",
        "description": "Message ID (for read/download)"
      },
      "to": {
        "type": "string",
        "description": "Recipient (for send)"
      },
      "subject": {
        "type": "string",
        "description": "Subject (for send)"
      },
      "body": {
        "type": "string",
        "description": "Body text (for send)"
      },
      "attachments": {
        "type": "string",
        "description": "Comma-separated file paths to attach (for send)"
      },
      "save_dir": {
        "type": "string",
        "description": "Where to save downloaded files (for download)"
      }
    }
  }
}
